    "Add the widget: right-click the desktop, choose Edit Widgets, then search for “Lune”. To change the place, right-click the widget and choose Edit “Lune”." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the widget: right-click the desktop, choose Edit Widgets, then search for “Lune”. To change the place, right-click the widget and choose Edit “Lune”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez le widget : clic droit sur le bureau, « Modifier les widgets », puis cherchez « Lune ». Pour changer de lieu, faites un clic droit sur le widget et choisissez « Modifier “Lune” »."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widget hinzufügen: Rechtsklick auf den Schreibtisch, „Widgets bearbeiten“ wählen und nach „Lune“ suchen. Den Ort ändern Sie per Rechtsklick auf das Widget und „Lune“ bearbeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade el widget: clic derecho en el escritorio, «Editar widgets» y busca «Lune». Para cambiar el lugar, haz clic derecho en el widget y elige «Editar “Lune”»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi il widget: clic destro sulla scrivania, «Modifica widget», poi cerca «Lune». Per cambiare luogo, clic destro sul widget e scegli «Modifica “Lune”»."
          }
        }
      }
    },
